{
    "name": "wpcalibrate/wpcalibrate-calendar-sync",
    "description": "Two-way Google Calendar synchronization for WordPress by WPCalibrate.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "WPCalibrate",
            "email": "support@wpcalibrate.com",
            "homepage": "https://wpcalibrate.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "google/apiclient": "^2.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "WPCalibrate\\CalendarSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPCalibrate\\CalendarSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "Google\\Task\\Composer::cleanup",
        "deploy": "php scripts/deploy-ftp.php",
        "deploy:all": "php scripts/deploy-ftp.php --all",
        "deploy:watch": "php scripts/deploy-ftp.php --watch",
        "test": "php vendor/bin/phpunit"
    },
    "extra": {
        "google/apiclient-services": [
            "Calendar"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
